# The versions of everything hub runs. hack/up.sh reads this file, and the
# manifests in deploy/local get their contrib-virtual-workspaces image tag
# from it, so changing a value here moves the whole platform.

# The contrib-virtual-workspaces release or commit that tenancy and the
# marketplace come from. A release such as v0.2.0 uses the published
# images, tagged 0.2.0. A full commit SHA uses the images tagged
# sha-<commit>, and builds them from that commit when they are not
# published.
CONTRIB_VERSION=14476ca92695431da25bfb43762ccadf1d5a954a

# The console image. Empty builds it from console/. The CONSOLE_IMAGE
# environment variable overrides this, for example
# CONSOLE_IMAGE=ghcr.io/olamilekan000/kcp-hub/console:main make up.
CONSOLE_IMAGE=

# Helm chart versions.
CERT_MANAGER_VERSION=v1.19.2
ENVOY_GATEWAY_VERSION=v1.7.0
